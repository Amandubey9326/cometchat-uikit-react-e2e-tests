# Copy to .env and fill in. Never commit .env.

# prod | staging — selects REST + app hosts
COMETCHAT_ENV=prod
COMETCHAT_APP_ID=
COMETCHAT_REGION=us
COMETCHAT_AUTH_KEY=
# REST API key (full access) — used only for test-data setup / cleanup
COMETCHAT_API_KEY=

# Optional
# APP_DIR=/Users/<you>/uikit-react/sample-app   # sample app (default ~/uikit-react/sample-app)
# UIKIT_DIR=/Users/<you>/uikit-react            # UIKit repo with src/resources (default: APP_DIR/..)
# APP_PORT=3105                                 # port the framework starts the sample app on
# APP_MODE=dev                                 # use the Vite dev server instead of build + preview
# BASE_URL=https://…                            # test an already-running / deployed app instead
# PW_WORKERS=4
# PW_LOCALE=en-us                               # UI language: builds the app with VITE_COMETCHAT_LOCALE on its own port
# PW_RUN_ID=<id>                                # reuse personas of an earlier run (kept at teardown)
# KEEP_TEST_DATA=1                              # don't delete this run's data (debugging)
# PW_NO_FIREFOX=1                              # skip Firefox where it can't launch (ENV-001, macOS 27)
# NET_STRICT=0                                  # report, but don't fail on, unexpected browser errors
