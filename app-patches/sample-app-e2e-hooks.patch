+// stagging environment
 
+// Every value can be overridden with a VITE_COMETCHAT_* env var (used by the E2E
+// framework). An empty-string override clears it: an empty APP_ID shows the
+// credentials screen, and empty hosts fall back to the SDK's production hosts.
+const env = import.meta.env;
+const APP_ID: string = env.VITE_COMETCHAT_APP_ID ?? '';
+
+export const COMETCHAT_CONSTANTS = {
+  APP_ID,
+  REGION: (env.VITE_COMETCHAT_REGION ?? 'us') as string,
+  AUTH_KEY: (env.VITE_COMETCHAT_AUTH_KEY ?? '') as string,
+  CLIENT_HOST: (env.VITE_COMETCHAT_CLIENT_HOST ?? `${APP_ID}.apiclient-us.cometchat-staging.com/v3`) as string,
+  ADMIN_HOST: (env.VITE_COMETCHAT_ADMIN_HOST ?? `${APP_ID}.api-us.cc-cluster-2.io/v3`) as string,
